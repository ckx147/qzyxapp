# Optional: target URL used by the browser smoke test.
# Defaults to http://localhost:3000 when not set.
APP_URL="http://localhost:3000"

# Data service port switch.
# Keep this false by default: the app uses local gameStorage until the WeChat
# cloud functions are deployed and smoke-tested on a real WeChat cloud env.
VITE_USE_WECHAT_CLOUD=false

# This app currently does not use Gemini or any server-side AI API.
